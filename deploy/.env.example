# 部署端口（docker-compose 端口映射 + 部署脚本 healthcheck 使用）
OCI_PORT=9856

# 统一入口反代（web/nginx）端口，浏览器访问入口
OCI_WEB_PORT=9857

# 是否启用 Modern UI（默认 true）
MODERN_UI_ENABLED=true

# H2 数据库密码（留空=空密码；生产建议设置并妥善保管）
DB_PASSWORD=

# 说明：
# - Telegram 通知的 Bot Token / Chat ID / Chat Name 在「通知通道」页面维护，已存入数据库 system_config，无需在此配置。
# - 原先的 TELEGRAM_TOKEN / TELEGRAM_BOT_ID / TELEGRAM_BOT_USERNAME / RSA_PRIVATE_KEY
#   在现有代码中没有被消费，已不需要。
# - MAXMIND_LICENSE_KEY 仅供构建时下载 GeoLite2-City（本地 export 或 GitHub Actions Secret），不需要写入 deploy/.env。
