# 部署端口（默认仅绑本地 127.0.0.1 回环，对外由 Nginx 9857 统一反代，防止公网直连绕过防护）
OCI_PORT=9856
OCI_PORT_BIND=127.0.0.1

# 统一入口反代（web/nginx）端口，浏览器公网访问入口
OCI_WEB_PORT=9857

# 容器时区（默认 Asia/Shanghai 即北京时间 UTC+8；海外服务器或跨境用户可按需改为 America/New_York、UTC 等）
TZ=Asia/Shanghai

# 是否启用 Modern UI（默认 true）
MODERN_UI_ENABLED=true

# H2 数据库密码（安全核心配置：强烈建议设置 16 位以上强密码）
# 作用：用于加密与保护本地 H2 数据库文件（./data/vps_db.mv.db），防止 VPS 被入侵后租户 API 私钥被离线脱库。
# 自动化说明：使用 install.sh 全新安装时，脚本会自动生成 24 位高强度随机密码并填入；若手动部署请务必自行填写。
DB_PASSWORD=

# 初始管理员凭据（全新安装时自动生成强密码并在终端打印；无需在网页手动注册，零安全真空期）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 说明：
# - Telegram 通知的 Bot Token / Chat ID / Chat Name 在「通知通道」页面维护，已存入数据库 system_config，无需在此配置。
# - 原先的 TELEGRAM_TOKEN / TELEGRAM_BOT_ID / TELEGRAM_BOT_USERNAME / RSA_PRIVATE_KEY
#   在现有代码中没有被消费，已不需要。
# - MAXMIND_LICENSE_KEY 仅供构建时下载 GeoLite2-City（本地 export 或 GitHub Actions Secret），不需要写入 deploy/.env。
